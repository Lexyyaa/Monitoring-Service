########################################################################
# 백엔드 DB 연결 환경변수 예시 (docker-compose.yml 기본값과 동일, 로컬 개발 전용 값)
# 자동으로 읽지 않는다. 셸에서 set -a; source .env.example; set +a 로 적용
# 다른 DB를 쓸 때 DB_URL·DB_USER·DB_PASSWORD만 바꿔 bootRun 한다
########################################################################

DB_URL=jdbc:postgresql://localhost:5432/monitoring
DB_USER=monitoring
DB_PASSWORD=monitoring_dev
